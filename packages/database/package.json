{
  "name": "@funti3r/database",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "type-check": "tsc --noEmit",
    "db:migrate": "node dist/migrations/run.js",
    "db:migrate:create": "node dist/migrations/create.js"
  },
  "dependencies": {
    "@funti3r/shared-types": "workspace:*",
    "@funti3r/shared-utils": "workspace:*",
    "pg": "^8.11.0",
    "redis": "^4.6.0",
    "mongodb": "^6.3.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/pg": "^8.11.0",
    "typescript": "^5.3.0"
  }
}
