{
  "name": "funti3r-pay",
  "version": "0.1.0",
  "description": "Blockchain-powered cross-border workforce payments",
  "private": true,
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=22.13.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "predev": "node scripts/free-ports.mjs",
    "dev": "turbo run dev",
    "free-ports": "node scripts/free-ports.mjs",
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,json,md}\"",
    "db:migrate": "turbo run db:migrate",
    "type-check": "turbo run type-check"
  },
  "devDependencies": {
    "@eslint/js": "^10",
    "@types/node": "^20.10.0",
    "eslint": "^10.13.0",
    "prettier": "^3.9.10",
    "turbo": "^2.11.9",
    "typescript": "^5.3.0",
    "typescript-eslint": "^8"
  },
  "pnpm": {
    "overrides": {
      "typescript": "^5.3.0",
      "protobufjs": "^7.6.1",
      "shell-quote": ">=1.9.0",
      "proxy-addr": ">=2.0.8",
      "axios": ">=1.20.0",
      "brace-expansion@<1.1.19": "^1.1.19",
      "browserslist": ">=4.28.7",
      "compression": ">=1.8.2",
      "form-data@>=4.0.0 <4.0.6": ">=4.0.6",
      "image-size": ">=2.0.3",
      "ip-address": ">=10.3.1",
      "joi": "^17.13.9",
      "js-yaml@>=3.0.0 <3.15.1": "^3.15.1",
      "smol-toml": ">=1.7.1",
      "toml": ">=4.1.2",
      "ws@>=8.0.0 <8.21.0": "^8.21.0",
      "dompurify": ">=3.4.17",
      "brace-expansion@>=2.0.0 <2.1.7": "^2.1.7",
      "handlebars": ">=4.7.10",
      "qs": ">=6.16.1",
      "body-parser": ">=2.4.0",
      "fast-xml-parser": ">=5.7.0",
      "follow-redirects": ">=1.16.2",
      "esbuild@>=0.27.3 <0.28.1": "^0.28.1",
      "postcss@<8.5.23": "^8.5.23",
      "nanoid@<3.3.18": "^3.3.18",
      "source-map-js@<1.2.2": "^1.2.2"
    }
  }
}
