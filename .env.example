# ── Databases ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://funti3r_dev:dev_password@localhost:5432/funti3r_dev
REDIS_URL=redis://localhost:6379

# ── Stellar ────────────────────────────────────────────────────────────────────
STELLAR_NETWORK=TESTNET
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
STELLAR_SOROBAN_URL=https://soroban-testnet.stellar.org
STELLAR_NETWORK_PASSPHRASE=Test SDF Network ; September 2015

# Funded operator keypair used to deploy SmartWallet contracts.
# Generate with: stellar keys generate --network testnet
STELLAR_OPERATOR_SECRET=

# Settlement asset (XLM for testnet; set to USDC for production)
STELLAR_SETTLEMENT_ASSET=XLM
STELLAR_USDC_ISSUER=GBBD47IF6LWK7P7MDEVSCWR7DPUWV3NY3DTQEVFL4NAT4AQH3ZLLFLA5

# ── Encryption ────────────────────────────────────────────────────────────────
# 32-byte hex key for AES-256-GCM enterprise wallet key encryption.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MASTER_ENCRYPTION_KEY=

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET=change-this-to-a-long-random-secret-in-production
# Set to 15m for production; 24h is convenient for development
JWT_EXPIRATION=15m

# ── WebAuthn ──────────────────────────────────────────────────────────────────
RP_NAME=Funti3r-Pay
RP_ID=localhost
RP_ORIGIN=http://localhost:3100

# ── API Gateway ───────────────────────────────────────────────────────────────
API_PORT=3000
ALLOWED_ORIGINS=http://localhost:3100
NODE_ENV=development

# ── Service ports (override only if running outside Docker) ──────────────────
USER_SERVICE_PORT=3001
PAYMENT_SERVICE_PORT=3002
COMPLIANCE_SERVICE_PORT=3003
ANALYTICS_SERVICE_PORT=3004

# ── Service URLs (used by api-gateway; auto-set in docker-compose) ────────────
USER_SERVICE_URL=http://localhost:3001
PAYMENT_SERVICE_URL=http://localhost:3002
COMPLIANCE_SERVICE_URL=http://localhost:3003
ANALYTICS_SERVICE_URL=http://localhost:3004

# ── Compliance ────────────────────────────────────────────────────────────────
# Set to true on testnet to auto-approve all KYC submissions instantly.
COMPLIANCE_AUTO_APPROVE=true
# HMAC secret for validating KYC provider webhook callbacks.
COMPLIANCE_WEBHOOK_SECRET=

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=debug

# ── Fiat payment rails (leave blank to disable; service falls back to Stellar) ─
MONEYGRAM_API_KEY=
MONEYGRAM_API_URL=https://extgw-sandbox.moneygram.com
MONEYGRAM_PARTNER_ID=

FLUTTERWAVE_SECRET_KEY=

AIRTM_API_KEY=
AIRTM_API_SECRET=
AIRTM_API_URL=https://sandbox-api.airtm.com/v1

PUNTORED_API_KEY=
PUNTORED_API_URL=https://api.puntored.com.co/v1

# ── Milestone escrow (Soroban) ───────────────────────────────────────────────
# Address printed by services/payment-service/scripts/deploy-escrow.ts
ESCROW_CONTRACT_ADDRESS=
# Secret of the compliance authority (the contract's `compliance` role); a funded
# account distinct from the operator/admin. Grants and revokes worker clearances.
ESCROW_COMPLIANCE_SECRET=
# How long an on-chain worker clearance lives, in seconds (default 86400)
ESCROW_CLEARANCE_TTL_SECONDS=

# ── Stellar anchor cash-out ──────────────────────────────────────────────────
# Anchor used to disburse claimed milestones to a bank / cash pickup
ANCHOR_HOME_DOMAIN=testanchor.stellar.org
# sep24 (interactive) | sep6. Unset = SEP-24 when the anchor offers it.
ANCHOR_PROTOCOL=
# TESTNET ONLY, opt-in: fill in the SDF reference anchor's blank SEP-24 form from
# the worker's saved payout details. Ignored on mainnet and for any other anchor.
ANCHOR_AUTOFILL_REFERENCE_UI=false
